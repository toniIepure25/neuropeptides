# Runtime configuration for ntx. Copy to .env and edit; never commit secrets.
# All variables are optional; bundled defaults are used when unset.

# Where data/, build/ and reports/ live. Defaults to the nearest pyproject.toml
# ancestor, then the current working directory.
NTX_ROOT=

# Per-directory overrides (take precedence over NTX_ROOT).
NTX_DATA=
NTX_BUILD=
NTX_REPORTS=

# Explicit database / corpus / configuration files.
NTX_DB=
NTX_CORPUS=
NTX_ONTOLOGY=
NTX_QUERIES=
NTX_CONFIG=
NTX_CACHE=
NTX_HOST=
NTX_PORT=
NTX_BOOTSTRAP=
NTX_RESOLVE_COREF=

# Reproducibility: freeze every timestamp (ISO-8601 instant, or 1 for the epoch).
NTX_FROZEN_TIME=

# Logging: DEBUG, INFO, WARNING, ERROR (JSON to stderr).
NTX_LOG_LEVEL=WARNING
